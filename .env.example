# Example environment variables
# Use PostgreSQL by setting DATABASE_URL (recommended for production)
# DATABASE_URL=postgres://user:password@localhost:5432/vehicle_service_db

# Project uses PostgreSQL only. Set DATABASE_URL to connect:
# DATABASE_URL=postgres://user:password@localhost:5432/vehicle_service_db

# JWT secret (required in production)
# JWT_SECRET=your_super_secret_here

# Server port (optional)
# PORT=5000
# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password
DB_NAME=vehicle_service_db

# Server Configuration
PORT=5000

# JWT Secret
JWT_SECRET=your_jwt_secret_key_change_this_in_production
